# Doxygen configuration for the ravel API reference.
#   doxygen docs/Doxyfile      (from the repository root)
# or build the `ravel_docs` CMake target when Doxygen is installed.

PROJECT_NAME           = "ravel"
PROJECT_BRIEF          = "Deterministic simulation testing for C++. Seed a bug, replay it exact."
OUTPUT_DIRECTORY       = build-docs
INPUT                  = README.md CHANGELOG.md CONTRIBUTING.md SECURITY.md CODE_OF_CONDUCT.md include docs/concepts.md docs/tutorial.md docs/porting.md docs/debugging.md docs/ci.md docs/example-kv.md docs/formats.md docs/abi-policy.md
FILE_PATTERNS          = *.hpp *.h *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = README.md
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
MARKDOWN_SUPPORT       = YES
MARKDOWN_ID_STYLE      = GITHUB
TOC_INCLUDE_HEADINGS   = 6
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
SOURCE_BROWSER         = NO
QUIET                  = YES
EXCLUDE_SYMBOLS        = *::await_ready *::await_suspend *::await_resume *await_ready *await_suspend *await_resume *promise_type
WARN_IF_UNDOCUMENTED   = YES
WARN_AS_ERROR          = NO
